# URQEN Environment Configuration
# Copy this file to .env and fill in your Supabase credentials

# Supabase Credentials (from https://supabase.com -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Needed only for legacy HS256 JWT signing keys; asymmetric keys use SUPABASE_URL's JWKS.
SUPABASE_JWT_SECRET=your-jwt-secret
ADMIN_EMAILS=founder@example.com

# Storage quota per user in bytes (default 50 MB = 52428800)
USER_QUOTA_BYTES=52428800
